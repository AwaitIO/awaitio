{
  "name": "awaitio",
  "version": "0.1.0",
  "description": "Internal tools in one process: actions in code await a human's answer, the same server serves the UI.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/esm/client/index.d.ts",
      "default": "./dist/esm/client/index.js"
    },
    "./ui": {
      "types": "./dist/uikit/index.d.ts",
      "default": "./dist/uikit/index.js"
    },
    "./vite": "./vite/componentBuildConfig.mjs"
  },
  "files": [
    "dist",
    "vite"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc -p tsconfig.client.json && vite build",
    "dev": "tsc -p tsconfig.client.json --watch --preserveWatchOutput & tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:ui": "vite",
    "tsc": "tsc --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.ui.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^4.21.2",
    "luxon": "^3.7.2",
    "react": "^19.1.0",
    "ts-pattern": "^5.9.0",
    "zod": "3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/express": "^4.17.21",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "geist": "1.4.2",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}

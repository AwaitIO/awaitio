{
  "name": "@awaitio/input-date",
  "version": "1.1.0",
  "description": "Date input for AwaitIO: io.input.date(), returns a luxon DateTime.",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && vite build",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & vite build --watch",
    "tsc": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "release": "pnpm build && pnpm publish --access public --no-git-checks"
  },
  "peerDependencies": {
    "awaitio": "workspace:^",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "dependencies": {
    "luxon": "^3.7.2",
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^5.0.0",
    "awaitio": "workspace:*",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "zod": "^4.3.6"
  }
}

# DEMO SERVER (apps/demo)
# Signs the session cookies. At least 32 characters; changing it logs everyone out.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars
# The demo logs in with demo@awaitio.com and the password "demo" (src/users.ts), nothing to set here.
PORT=3000
# 0.0.0.0 in a container, so the platform can reach it.
HOST=127.0.0.1

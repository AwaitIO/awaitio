# DEMO SERVER (apps/demo)
# Signs the session cookies. At least 32 characters; changing it logs everyone out.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars
# The demo user. Start the demo, open http://localhost:3000/access (Create new account) and copy the email and
# passwordHash it gives you here. Without them the demo starts, but nobody can log in.
# DEMO_USER_EMAIL=you@example.com
# DEMO_USER_PASSWORD_HASH=scrypt$...
PORT=3000

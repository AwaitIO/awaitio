# DEMO SERVER (apps/demo)
# Signs the session cookies. At least 32 characters; changing it logs everyone out.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-32-chars
# The demo user. The hash comes from `pnpm hash-password`.
DEMO_USER_EMAIL=you@example.com
DEMO_USER_PASSWORD_HASH=scrypt$32768$8$1$...
PORT=3000

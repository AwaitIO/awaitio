{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AwaitIO",
  "colors": {
    "primary": "#D9733F",
    "light": "#E08A58",
    "dark": "#C2602F"
  },
  "background": {
    "color": {
      "light": "#F6F2EA",
      "dark": "#1E1A16"
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://awaitio.com"
  },
  "favicon": "/favicon.svg",
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt"],
    "display": "header"
  },
  "seo": {
    "metatags": {
      "og:image": "https://awaitio.com/og/documentation.png",
      "og:image:width": "1200",
      "og:image:height": "630",
      "twitter:image": "https://awaitio.com/og/documentation.png",
      "twitter:card": "summary_large_image"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "AwaitIO homepage",
          "icon": "house",
          "href": "https://awaitio.com"
        },
        {
          "anchor": "Demo",
          "icon": "play",
          "href": "https://awaitio.com/demo"
        },
        {
          "anchor": "Changelog",
          "icon": "clock-rotate-left",
          "href": "https://docs.awaitio.com/changelog"
        }
      ]
    },
    "groups": [
      {
        "group": "Getting started",
        "pages": ["index", "quickstart", "how-it-works", "deployment"]
      },
      {
        "group": "SDK",
        "pages": ["core/app", "core/name", "core/routing", "core/listen", "core/pages", "core/users", "core/environments", "core/theme"]
      },
      {
        "group": "Input components",
        "pages": [
          "core/input-components",
          "io/input-text",
          "io/input-email",
          "io/input-url",
          "io/input-textarea",
          "io/input-number",
          "io/input-boolean",
          "io/input-datetime",
          "io/input-date",
          "io/select-single",
          "io/select-single-native",
          "io/select-multiple",
          "io/select-table",
          "io/confirm",
          "io/group"
        ]
      },
      {
        "group": "Display components",
        "pages": [
          "core/display-components",
          "io/display-table",
          "io/display-metadata",
          "io/display-link",
          "io/display-heading",
          "io/display-image",
          "io/display-markdown",
          "io/display-object",
          "io/display-html"
        ]
      },
      {
        "group": "Layout components",
        "pages": ["core/layout-components", "io/layout-basic"]
      },
      {
        "group": "Context",
        "pages": ["ctx/user", "ctx/params", "ctx/action", "ctx/run-id", "ctx/redirect", "ctx/loading-start"]
      },
      {
        "group": "Other",
        "pages": ["license", "changelog"]
      }
    ]
  }
}

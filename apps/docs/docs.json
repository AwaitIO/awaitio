{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AwaitIO",
  "colors": {
    "primary": "#2563EB",
    "light": "#60A5FA",
    "dark": "#1D4ED8"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "AwaitIO homepage",
          "icon": "house",
          "href": "https://awaitio.com"
        },
        {
          "anchor": "Changelog",
          "icon": "clock-rotate-left",
          "href": "https://awaitio.com/changelog"
        }
      ]
    },
    "groups": [
      {
        "group": "Getting started",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "SDK",
        "pages": ["core/app", "core/routing", "core/listen", "core/pages", "core/users", "core/environments", "core/theme"]
      },
      {
        "group": "Input components",
        "pages": [
          "core/input-components",
          "io/input-text",
          "io/input-email",
          "io/input-url",
          "io/input-textarea",
          "io/input-number",
          "io/input-boolean",
          "io/input-datetime",
          "io/input-date",
          "io/select-single",
          "io/select-multiple",
          "io/select-table",
          "io/confirm"
        ]
      },
      {
        "group": "Display components",
        "pages": [
          "core/display-components",
          "io/display-table",
          "io/display-metadata",
          "io/display-link",
          "io/display-heading",
          "io/display-image",
          "io/display-markdown",
          "io/display-object",
          "io/display-html"
        ]
      },
      {
        "group": "Layout components",
        "pages": ["core/layout-components", "io/layout-basic"]
      },
      {
        "group": "Context",
        "pages": ["ctx/user", "ctx/loading-start"]
      }
    ]
  }
}

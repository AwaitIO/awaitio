# Secrets for .kamal/deploy.yml. Committed, so it holds commands, never values.

# The demo keeps its runs in process memory, so every deploy starts empty anyway and a fresh
# session secret per deploy costs nothing.
SESSION_SECRET=$(openssl rand -base64 48)
# Password of the registry on the Droplet: from the environment in CI (GitHub Secret),
# the macOS Keychain on the Mac, or a file on Linux machines
KAMAL_REGISTRY_PASSWORD=$(printenv KAMAL_REGISTRY_PASSWORD || security find-generic-password -s kamal-registry -w 2>/dev/null || cat ~/.config/kamal/registry-password)

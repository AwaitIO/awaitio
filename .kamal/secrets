# Secrets for .kamal/deploy.yml. Committed, so it holds commands, never values.
# Read on the deploying machine (see .claude/guidelines/deploy.md).

# The demo keeps its runs in process memory, so every deploy starts empty anyway and a fresh
# session secret per deploy costs nothing. Not openssl: the official Kamal image has none.
SESSION_SECRET=$(head -c 48 /dev/urandom | base64 | tr -d '\n')
# Password of the registry on the Droplet: the macOS Keychain, else a mode 600 file
KAMAL_REGISTRY_PASSWORD=$(security find-generic-password -s kamal-registry -w 2>/dev/null || cat ~/.config/kamal/registry-password)

{
  "name": "awaitit-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter './libs/**' run build && pnpm -r --parallel run dev",
    "dev:ui": "pnpm --filter awaitit run dev:ui",
    "start": "pnpm --filter @awaitit/demo run start",
    "tsc": "pnpm --filter './libs/**' run build && pnpm -r run tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm --filter awaitit run build && pnpm -r run test"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.46.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.37.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "2.8.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "packageManager": "pnpm@9.3.0",
  "engines": {
    "node": "22.14.0"
  },
  "volta": {
    "node": "22.14.0"
  }
}
